# ==========================================
# MediBook Environment Variables
# ==========================================

# ------------------------------------------
# Application
# ------------------------------------------
VITE_APP_NAME=MediBook
VITE_APP_URL=http://localhost:5173
VITE_APP_VERSION=1.0.0

# ------------------------------------------
# Demo Mode
# ------------------------------------------
VITE_DEMO_MODE=true

# ------------------------------------------
# API Configuration
# (Update when backend is connected)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api

# ------------------------------------------
# Local Storage Keys
# ------------------------------------------
VITE_AUTH_TOKEN_KEY=medibook_auth_token
VITE_REFRESH_TOKEN_KEY=medibook_refresh_token
VITE_USER_KEY=medibook_user
VITE_THEME_KEY=medibook_theme

# ------------------------------------------
# Feature Flags
# ------------------------------------------
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_APPOINTMENTS=true
VITE_ENABLE_DOCTOR_PORTAL=true
VITE_ENABLE_ADMIN_PORTAL=true
VITE_ENABLE_PATIENT_PORTAL=true